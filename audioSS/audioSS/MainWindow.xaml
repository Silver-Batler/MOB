<Window x:Class="audioSS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Editor" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" 
                Background="#FFFFFF" 
                BorderBrush="#E0E4E8" 
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open Audio" 
                        Margin="5" 
                        Padding="12,6" 
                        FontSize="14"
                        Background="#4A90E2"
                        Foreground="White"
                        BorderThickness="0"
                        Click="OpenButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#357ABD"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#2A6099"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Play" 
                        Margin="5" 
                        Padding="12,6" 
                        FontSize="14"
                        Background="#2ECC71"
                        Foreground="White"
                        BorderThickness="0"
                        Click="PlayButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#27AE60"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#219653"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Pause" 
                        Margin="5" 
                        Padding="12,6" 
                        FontSize="14"
                        Background="#F39C12"
                        Foreground="White"
                        BorderThickness="0"
                        Click="PauseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E67E22"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#D35400"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Stop" 
                        Margin="5" 
                        Padding="12,6" 
                        FontSize="14"
                        Background="#E74C3C"
                        Foreground="White"
                        BorderThickness="0"
                        Click="StopButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#C0392B"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#A93226"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Trim Audio" 
                        Margin="5" 
                        Padding="12,6" 
                        FontSize="14"
                        Background="#F1C40F"
                        Foreground="White"
                        BorderThickness="0"
                        Click="TrimButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#D4AC0D"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#B7950B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Volume Slider -->
                <TextBlock Text="Volume:" 
                           VerticalAlignment="Center"
                           Margin="10,0,5,0"
                           FontSize="14"
                           Foreground="#34495E"/>
                <Slider x:Name="VolumeSlider"
                        Width="150"
                        Height="30"
                        Minimum="0"
                        Maximum="1"
                        Value="1"
                        TickFrequency="0.1"
                        ValueChanged="VolumeSlider_ValueChanged"
                        VerticalAlignment="Center"
                        Margin="10"
                        Background="#FFFFFF"
                        Foreground="#007ACC"
                        
                        BorderThickness="1"
                        TickPlacement="BottomRight"
                        AutoToolTipPlacement="TopLeft"
                        AutoToolTipPrecision="2"
                        />

                <!-- Audio Timer -->
                <TextBlock x:Name="AudioTimerText"
                           Text="00:00 / 00:00"
                           VerticalAlignment="Center"
                           Margin="10,0,5,0"
                           FontSize="14"
                           Foreground="#34495E"/>
            </StackPanel>
        </Border>

        <!-- Waveform Display -->
        <Border Grid.Row="1" 
                Margin="10" 
                Background="#FFFFFF"
                BorderBrush="#E0E4E8"
                BorderThickness="1"
                CornerRadius="5">
            <Canvas x:Name="WaveformCanvas" 
                    Background="#ECF0F1"
                    MouseDown="WaveformCanvas_MouseDown"
                    MouseMove="WaveformCanvas_MouseMove"
                    MouseUp="WaveformCanvas_MouseUp"
                    Height="200px"/>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#FFFFFF"
                BorderBrush="#E0E4E8"
                BorderThickness="0,1,0,0"
                Padding="10">
            <TextBlock x:Name="StatusText" 
                       Text="No audio loaded"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="#7F8C8D"/>
        </Border>
    </Grid>
</Window>

