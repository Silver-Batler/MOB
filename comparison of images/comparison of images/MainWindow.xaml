<Window x:Class="comparison_of_images.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="500" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>
    <Grid>
        <Button Content="Загрузить изображение"
                Width="160" Height="30"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,10,0,0"
                Click="LoadImage_Click"/>

        <CheckBox x:Name="GuidelinesCheckBox"
                  Content="Показать направляющие"
                  IsChecked="True" 
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="10,10,10,10"/>

        <CheckBox x:Name="DiagonalGuidesCheckBox"
                  Content="Диагональные направляющие"
                  IsChecked="True"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="10"/>

        <UniformGrid Rows="1" Margin="0,50,0,0">
            <StackPanel x:Name="Container1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5" Visibility="Visible">
                <Border Width="212" Padding="2" BorderThickness="1" BorderBrush="Gray">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FileNameTextBlock1"
                                 Width="125"
                                 TextTrimming="CharacterEllipsis"
                                 FontWeight="Bold"/>
                        <TextBlock x:Name="ImageSizeTextBlock1"
                                 Margin="5,0,0,0"
                                 FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Width="212" Height="342"
                        BorderBrush="Gray" BorderThickness="2"
                        ClipToBounds="True">
                    <Grid x:Name="ImageContainer1" Background="Gray">
                        <Image x:Name="DisplayedImage1"
                             MouseWheel="Image_MouseWheel"
                             MouseLeftButtonDown="Image_MouseLeftButtonDown"
                             MouseLeftButtonUp="Image_MouseLeftButtonUp"
                             MouseRightButtonDown="Image_MouseRightButtonDown"
                             MouseMove="Image_MouseMove"
                             MouseDown="Image_MouseDown"
                             Stretch="Uniform"
                             RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale1" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ImageRotate1" Angle="0"/>
                                    <TranslateTransform x:Name="ImageTranslate1" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <Line X1="0" Y1="0.5" X2="1" Y2="0.5"
                            Stroke="Red" StrokeThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Stretch="Fill"
                            Visibility="{Binding ElementName=GuidelinesCheckBox, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"/>
                        <Line X1="0.5" Y1="0" X2="0.5" Y2="1"
                            Stroke="Red" StrokeThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Stretch="Fill"
                            Visibility="{Binding ElementName=GuidelinesCheckBox, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"/>
                        <Line x:Name="DiagonalLine1_1"
                            Stroke="Green" StrokeThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                        <Line x:Name="DiagonalLine1_2"
                            Stroke="Green" StrokeThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="Container2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5" Visibility="Collapsed">
                <Border Width="212" Padding="2" BorderThickness="1" BorderBrush="Gray">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FileNameTextBlock2"
                                 Width="125"
                                 TextTrimming="CharacterEllipsis"
                                 FontWeight="Bold"/>
                        <TextBlock x:Name="ImageSizeTextBlock2"
                                 Margin="5,0,0,0"
                                 FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Width="212" Height="342" BorderBrush="Gray" BorderThickness="2" ClipToBounds="True">
                    <Grid x:Name="ImageContainer2" Background="Gray">
                        <Image x:Name="DisplayedImage2"
                             MouseWheel="Image_MouseWheel"
                             MouseLeftButtonDown="Image_MouseLeftButtonDown"
                             MouseLeftButtonUp="Image_MouseLeftButtonUp"
                             MouseRightButtonDown="Image_MouseRightButtonDown"
                             MouseMove="Image_MouseMove"
                             MouseDown="Image_MouseDown"
                             Stretch="Uniform"
                             RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale2" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ImageRotate2" Angle="0"/>
                                    <TranslateTransform x:Name="ImageTranslate2" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <Line X1="0" Y1="0.5" X2="1" Y2="0.5"
                            Stroke="Red" StrokeThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Stretch="Fill"
                            Visibility="{Binding ElementName=GuidelinesCheckBox, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"/>
                        <Line X1="0.5" Y1="0" X2="0.5" Y2="1"
                            Stroke="Red" StrokeThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Stretch="Fill"
                            Visibility="{Binding ElementName=GuidelinesCheckBox, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"/>
                        <Line x:Name="DiagonalLine2_1"
                            Stroke="Green" StrokeThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                        <Line x:Name="DiagonalLine2_2"
                            Stroke="Green" StrokeThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="Container3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5" Visibility="Collapsed">
                <Border Width="212" Padding="2" BorderThickness="1" BorderBrush="Gray">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FileNameTextBlock3"
                                 Width="125"
                                 TextTrimming="CharacterEllipsis"
                                 FontWeight="Bold"/>
                        <TextBlock x:Name="ImageSizeTextBlock3"
                                 Margin="5,0,0,0"
                                 FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Width="212" Height="342" BorderBrush="Gray" BorderThickness="2" ClipToBounds="True">
                    <Grid x:Name="ImageContainer3" Background="Gray">
                        <Image x:Name="DisplayedImage3"
                             MouseWheel="Image_MouseWheel"
                             MouseLeftButtonDown="Image_MouseLeftButtonDown"
                             MouseLeftButtonUp="Image_MouseLeftButtonUp"
                             MouseRightButtonDown="Image_MouseRightButtonDown"
                             MouseMove="Image_MouseMove"
                             MouseDown="Image_MouseDown"
                             Stretch="Uniform"
                             RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale3" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ImageRotate3" Angle="0"/>
                                    <TranslateTransform x:Name="ImageTranslate3" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <Line X1="0" Y1="0.5" X2="1" Y2="0.5"
                            Stroke="Red" StrokeThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Stretch="Fill"
                            Visibility="{Binding ElementName=GuidelinesCheckBox, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"/>
                        <Line X1="0.5" Y1="0" X2="0.5" Y2="1"
                            Stroke="Red" StrokeThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Stretch="Fill"
                            Visibility="{Binding ElementName=GuidelinesCheckBox, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"/>
                        <Line x:Name="DiagonalLine3_1"
                            Stroke="Green" StrokeThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                        <Line x:Name="DiagonalLine3_2"
                            Stroke="Green" StrokeThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="Container4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5" Visibility="Collapsed">
                <Border Width="212" Padding="2" BorderThickness="1" BorderBrush="Gray">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FileNameTextBlock4"
                                 Width="125"
                                 TextTrimming="CharacterEllipsis"
                                 FontWeight="Bold"/>
                        <TextBlock x:Name="ImageSizeTextBlock4"
                                 Margin="5,0,0,0"
                                 FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Width="212" Height="342" BorderBrush="Gray" BorderThickness="2" ClipToBounds="True">
                    <Grid x:Name="ImageContainer4" Background="Gray">
                        <Image x:Name="DisplayedImage4"
                             MouseWheel="Image_MouseWheel"
                             MouseLeftButtonDown="Image_MouseLeftButtonDown"
                             MouseLeftButtonUp="Image_MouseLeftButtonUp"
                             MouseRightButtonDown="Image_MouseRightButtonDown"
                             MouseMove="Image_MouseMove"
                             MouseDown="Image_MouseDown"
                             Stretch="Uniform"
                             RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale4" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ImageRotate4" Angle="0"/>
                                    <TranslateTransform x:Name="ImageTranslate4" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <Line X1="0" Y1="0.5" X2="1" Y2="0.5"
                            Stroke="Red" StrokeThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Stretch="Fill"
                            Visibility="{Binding ElementName=GuidelinesCheckBox, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"/>
                        <Line X1="0.5" Y1="0" X2="0.5" Y2="1"
                            Stroke="Red" StrokeThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Stretch="Fill"
                            Visibility="{Binding ElementName=GuidelinesCheckBox, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"/>
                        <Line x:Name="DiagonalLine4_1"
                            Stroke="Green" StrokeThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                        <Line x:Name="DiagonalLine4_2"
                            Stroke="Green" StrokeThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </StackPanel>
        </UniformGrid>
    </Grid>
</Window>
